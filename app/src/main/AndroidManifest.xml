<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS Permissions for Nequi payment notifications and P2P inter-store coordination -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- 
      Android 11+ / Android 14 (API 34) Package Visibility:
      Permite consultar y vincular el motor de síntesis de voz (TextToSpeech)
      instalado en el sistema (Google TTS, Samsung TTS, etc.).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 
      IMPORTANTE:
      - CERO permiso android.permission.INTERNET.
      - Todo se procesa estrictamente de forma local en el dispositivo.
      - allowBackup="false" para proteger la privacidad del comercio y el PIN.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AmbiorixPay">

        <!-- Pantalla principal Kiosco -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Configuración protegida por PIN -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Configuración Ambiorix Pay"
            android:windowSoftInputMode="adjustResize" />

        <!-- 
          Servicio de escucha de notificaciones para pagos.
          Requiere BIND_NOTIFICATION_LISTENER_SERVICE otorgado explícitamente por el usuario
          en Ajustes del Sistema > Acceso a notificaciones.
        -->
        <service
            android:name=".notification.AmbiorixNotificationListener"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
